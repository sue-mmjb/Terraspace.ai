{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/app"
    }
  ],
  "headers": [
    {
      "source": "/app/(.*).(jpg|png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/marketing/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
